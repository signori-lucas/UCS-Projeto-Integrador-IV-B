@{
    ViewData["Title"] = "NomeBR – Descubra o Nome Perfeito";
}

<div class="spa-app container mt-4">
    <header class="mb-4">
        <div>
            <h2>NomeBR – Descubra o Nome Perfeito</h2>
            <p class="lead">Descubra tendências, popularidade e frequência de nomes no Brasil</p>
        </div>
    </header>

    <section class="mb-4">
        <div class="row">
            <div class="col-12">
                <div class="card search-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="d-flex flex-wrap gap-2 align-items-center flex-grow-1">
                                <div class="min-w-200 flex-grow-1">
                                    <div class="input-group d-flex">
                                        <input id="search-name" type="text" class="form-control flex-grow-1" placeholder="Digite um nome" />
                                        <button id="btn-search" class="btn btn-primary">Pesquisar</button>
                                    </div>
                                </div>

                                <div class="d-flex gap-2 align-items-center search-filters">
                                    <div class="d-flex align-items-center gap-1">
                                        <label for="filter-sex" class="mb-0">Sexo</label>
                                        <select id="filter-sex" class="form-select form-select-sm">
                                            <option value="all">Todos</option>
                                            <option value="M">Masculino</option>
                                            <option value="F">Feminino</option>
                                        </select>
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <label for="filter-state" class="mb-0">Localidade</label>
                                        <select id="filter-state" class="form-select form-select-sm">
                                            <option value="" selected>Todas</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="ms-3">
                                <button id="btn-clear" type="button" class="btn btn-outline-secondary">Limpar Filtros</button>
                            </div>
                        </div>

                        <div id="search-result" class="mt-3" style="display:none;">
                            <h5 id="result-name"></h5>
                            <p id="result-total"></p>
                            <p id="result-frequency"></p>
                            <div id="search-message" class="text-danger" style="display:none;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="row">
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header">Top 10 Nomes</div>
                <div class="card-body p-0">
                    <ol id="ranking-list" class="list-group list-group-flush"></ol>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Ranking por Década</span>
                    <select id="decade-selector" class="form-select form-select-sm w-auto">
                        <option value="1930">1930</option>
                        <option value="1940">1940</option>
                        <option value="1950">1950</option>
                        <option value="1960">1960</option>
                        <option value="1970">1970</option>
                        <option value="1980">1980</option>
                        <option value="1990" selected>1990</option>
                        <option value="2000">2000</option>
                        <option value="2010">2010</option>
                    </select>
                </div>
                <div class="card-body p-0">
                    <ol id="decade-ranking-list" class="list-group list-group-flush"></ol>
                </div>
            </div>
        </div>
    </section>

    <!-- messages removed as per request -->
</div>

@section Scripts {
    <script src="/js/app.js"></script>
}
